<Window x:Class="RF_SafetyScanner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Name="RootWindow"
        Title="RF Safety Scanner v3 - HackRF Pulsed/Wideband Monitor" Height="850" Width="1360"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="155"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="10" CornerRadius="8" Background="#202020">
            <TextBlock Foreground="White" FontSize="15" FontWeight="SemiBold"
                       Text="RF Safety Scanner v3 — detects receiver-relative carriers, wideband energy, pulsed/radar-like patterns, edge overload, and logs audio-risk events. Not a V/m or W/m² RF exposure meter."/>
        </Border>

        <Grid Grid.Row="1" Margin="0,10,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="85"/>
                <ColumnDefinition Width="85"/>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="95"/>
                <ColumnDefinition Width="95"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="80"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="4"><TextBlock Text="Start MHz"/><TextBox x:Name="StartMhzBox" Text="2.000"/></StackPanel>
            <StackPanel Grid.Column="1" Margin="4"><TextBlock Text="Stop MHz"/><TextBox x:Name="StopMhzBox" Text="10.000"/></StackPanel>
            <StackPanel Grid.Column="2" Margin="4"><TextBlock Text="Step kHz"/><TextBox x:Name="StepKhzBox" Text="5"/></StackPanel>
            <StackPanel Grid.Column="3" Margin="4"><TextBlock Text="Dwell ms"/><TextBox x:Name="DwellMsBox" Text="100"/></StackPanel>
            <StackPanel Grid.Column="4" Margin="4"><TextBlock Text="Alert dBFS"/><TextBox x:Name="AlertDbfsBox" Text="-65"/></StackPanel>
            <StackPanel Grid.Column="5" Margin="4"><TextBlock Text="Critical"/><TextBox x:Name="CriticalDbfsBox" Text="-58"/></StackPanel>
            <StackPanel Grid.Column="6" Margin="4"><TextBlock Text="Wide kHz"/><TextBox x:Name="WidebandKhzBox" Text="20"/></StackPanel>
            <StackPanel Grid.Column="7" Margin="4"><TextBlock Text="Over kHz"/><TextBox x:Name="OverloadKhzBox" Text="100"/></StackPanel>
            <StackPanel Grid.Column="8" Margin="4"><TextBlock Text="Edge kHz"/><TextBox x:Name="EdgeIgnoreKhzBox" Text="500"/></StackPanel>
            <StackPanel Grid.Column="9" Margin="4"><TextBlock Text="Pulse score"/><TextBox x:Name="PulseScoreBox" Text="0.35"/></StackPanel>

            <StackPanel Grid.Column="10" Margin="8,0,4,0">
                <TextBlock Text="Options"/>
                <WrapPanel>
                    <CheckBox x:Name="UseMockBox" Content="Mock if no HackRF" IsChecked="True" Margin="0,2,12,2"/>
                    <CheckBox x:Name="IgnoreEdgesBox" Content="Ignore edges" IsChecked="True" Margin="0,2,12,2"/>
                    <CheckBox x:Name="IgnoreCenterBox" Content="Ignore center DC" IsChecked="True" Margin="0,2,12,2"/>
                    <CheckBox x:Name="SmartMuteBox" Content="Smart mute critical" IsChecked="True" Margin="0,2,12,2"/>
                    <CheckBox x:Name="AutoStopBox" Content="Auto-stop on critical" IsChecked="False" Margin="0,2,12,2"/>
                </WrapPanel>
            </StackPanel>

            <Button Grid.Column="11" x:Name="StartButton" Content="Start Scan" Margin="8,18,4,4" Click="StartButton_Click"/>
            <Button Grid.Column="12" x:Name="StopButton" Content="Stop" Margin="4,18,4,4" Click="StopButton_Click" IsEnabled="False"/>
            <Button Grid.Column="13" x:Name="CloseButton" Content="Close" Margin="4,18,8,4" Click="CloseButton_Click"/>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.3*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="0,0,8,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <Grid Grid.Row="0" Margin="0,0,0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="0" Foreground="Gray" FontSize="11" HorizontalAlignment="Left"/>
                    <TextBlock Grid.Column="2" Text="25" Foreground="Gray" FontSize="11" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="4" Text="50" Foreground="Gray" FontSize="11" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="6" Text="75" Foreground="Gray" FontSize="11" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="8" Text="100" Foreground="Gray" FontSize="11" HorizontalAlignment="Right"/>
                </Grid>
                
                <ProgressBar x:Name="LevelProgressBar" Grid.Row="1" Height="24" Margin="0,0,0,8" Minimum="0" Maximum="100" />
                <DataGrid Grid.Row="2" x:Name="EventGrid" AutoGenerateColumns="False" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Time" Binding="{Binding Timestamp}" Width="155"/>
                    <DataGridTextColumn Header="MHz" Binding="{Binding FrequencyMhz, StringFormat=F3}" Width="80"/>
                    <DataGridTextColumn Header="dBFS" Binding="{Binding LevelDbfs, StringFormat=F1}" Width="70"/>
                    <DataGridTextColumn Header="BW kHz" Binding="{Binding BandwidthKhz, StringFormat=F1}" Width="80"/>
                    <DataGridTextColumn Header="Pulse" Binding="{Binding PulseScore, StringFormat=F2}" Width="65"/>
                    <DataGridTextColumn Header="Type" Binding="{Binding SignalType}" Width="155"/>
                    <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="90"/>
                    <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="*"/>
                </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="160"/>
                    <RowDefinition Height="160"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" BorderBrush="#BBB" BorderThickness="1" Padding="10" CornerRadius="8" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="Live Status" FontSize="18" FontWeight="Bold"/>
                        <TextBlock x:Name="StatusText" Text="Stopped" FontSize="14" Margin="0,8,0,0"/>
                        <TextBlock x:Name="CurrentFreqText" Text="Frequency: -" FontSize="14" Margin="0,4,0,0"/>
                        <TextBlock x:Name="CurrentLevelText" Text="Level: -" FontSize="14" Margin="0,4,0,0"/>
                        <TextBlock x:Name="CurrentBandwidthText" Text="Bandwidth: -" FontSize="14" Margin="0,4,0,0"/>
                        <TextBlock x:Name="CurrentPulseText" Text="Pulse score: -" FontSize="14" Margin="0,4,0,0"/>
                        <TextBlock x:Name="CurrentTypeText" Text="Type: -" FontSize="14" Margin="0,4,0,0"/>
                        <TextBlock x:Name="MuteText" Text="Mute state: -" FontSize="14" FontWeight="SemiBold" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" BorderBrush="#BBB" BorderThickness="1" Padding="8" CornerRadius="8" Margin="0,0,0,8">
                    <Grid>
                        <Canvas x:Name="SpectrumCanvas" Background="#0E1116"/>
                        <TextBlock Text="FFT / Peak Profile" Foreground="White" Margin="8" FontWeight="SemiBold"/>
                    </Grid>
                </Border>

                <Border Grid.Row="2" BorderBrush="#BBB" BorderThickness="1" Padding="8" CornerRadius="8" Margin="0,0,0,8">
                    <Grid>
                        <Canvas x:Name="PulseCanvas" Background="#101010"/>
                        <TextBlock Text="Pulse History / Radar-Like Pattern" Foreground="White" Margin="8" FontWeight="SemiBold"/>
                    </Grid>
                </Border>

                <Border Grid.Row="3" BorderBrush="#BBB" BorderThickness="1" Padding="10" CornerRadius="8">
                    <StackPanel>
                        <TextBlock Text="v3 Detection" FontSize="16" FontWeight="Bold"/>
                        <TextBlock TextWrapping="Wrap" Margin="0,8,0,0"
                                   Text="PULSED_WIDEBAND triggers when bandwidth is wide, signal is strong, and level changes rapidly across time. EDGE_OVERLOAD and CENTER_DC_SPIKE are ignored."/>
                        <Separator Margin="0,12,0,12"/>
                        <TextBlock TextWrapping="Wrap"
                                   Text="Use external limiter: threshold -10 dBFS, ceiling -3 dBFS, attack 1–5 ms, release 50–100 ms."/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <TextBox Grid.Row="3" x:Name="LogBox" Margin="0,10,0,0" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" IsReadOnly="True"/>
    </Grid>
</Window>
